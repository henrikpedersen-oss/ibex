# Build output
build

# Common editor/IDE config and temporary files
.project
.vscode/
.sw[a-p]
tags
*~

# ibex_tracer log file
trace_core_*.log

# Simple system output files
ibex_simple_system.log
ibex_simple_system_pcount.csv

# Python cache files
__pycache__

# This is generated by Questa tool when running DV simulations
modelsim.ini

# Compiled CHERIoT-Sail cosim DPI library (built by dv/cosim/cheriot_sail/Makefile)
dv/cosim/cheriot_sail/*.so

# Xcelium elaboration output for the compliance testbench (dv/riscv_compliance/build_xlm.sh).
# ~20 MB per build; the glob also covers the -o OUTDIR variants used for coverage runs.
dv/riscv_compliance/xlm_compliance_out*/

# Linker map emitted by the directed-test builds (-Wl,-Map=link.log in directed_testlist.yaml)
dv/uvm/core_ibex/link.log


# TestRIG build and run outputs (dv/testrig/README.md)
dv/testrig/xlm_testrig_out/
dv/testrig/vlt_testrig_out/
dv/testrig/cov_work/
# Written by xrun / SimVision into the directory they run in.
dv/testrig/xrun.key
dv/testrig/xmsc.log
dv/testrig/.simvision/
# Built by 'make -C dv/cosim/cheriot_sail emulator' (Verilator TestRIG flow).
dv/cosim/cheriot_sail/cheriot_sail_rvfi_emulator

# CHERIoT RTOS test SoC build and run outputs, including kept results (dv/cheriot-rtos-test-suites/README.md)
dv/cheriot-rtos-test-suites/xlm_rtos_out*/
dv/cheriot-rtos-test-suites/cov_work/
# Written by xrun / imc / SimVision into the directory they run in.
dv/cheriot-rtos-test-suites/xrun.key
dv/cheriot-rtos-test-suites/xrun.history
dv/cheriot-rtos-test-suites/imc.key
dv/cheriot-rtos-test-suites/mdv.log
dv/cheriot-rtos-test-suites/.simvision/
dv/cheriot-rtos-test-suites/*.shm/
