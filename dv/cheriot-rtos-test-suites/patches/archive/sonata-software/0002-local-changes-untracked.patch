+ * ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE
+ * IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE
+ * ARE DISCLAIMED.  IN NO EVENT SHALL THE AUTHOR OR CONTRIBUTORS BE LIABLE
+ * FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL
+ * DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS
+ * OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS INTERRUPTION)
+ * HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT
+ * LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY
+ * OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF
+ * SUCH DAMAGE.
+ */
+/*
+ * CHERIoT port (lowRISC, 2026): identical to cheri-c-tests/clang-purecap/clang_purecap_null.c
+ * except for the length of NULL. Upstream expects (size_t)-1, the 128-bit CHERI convention of a
+ * null capability spanning the address space. CHERIoT's null capability is all zeros
+ * (cheriot-sail cheri_cap_common.sail null_cap: B = T = E = 0), which decodes to base = top = 0,
+ * so its length is 0; a core returning (size_t)-1 would be the wrong one.
+ */
+#include "cheri_c_test.h"
+
+extern volatile long zero;
+volatile long zero;
+
+void is_null(void *p)
+{
+	assert_eq(__builtin_cheri_tag_get(p), 0);
+	assert_eq(__builtin_cheri_base_get(p), 0);
+	assert_eq(__builtin_cheri_offset_get(p), 0);
+	assert_eq(__builtin_cheri_length_get(p), 0); // CHERIoT: upstream has (size_t)-1
+}
+
+#pragma clang diagnostic ignored "-Wcheri-capability-misuse"
+
+BEGIN_TEST(clang_purecap_null)
+	void *p = 0;
+	is_null(p);
+	p = (void*)zero;
+	is_null(p);
+	p = (void*)(__uintcap_t)zero;
+	is_null(p);
+	zero += 42;
+	zero -= 42;
+	p = (void*)(__uintcap_t)zero;
+	is_null(p);
+END_TEST
+
diff --git a/examples/cheri_c_tests/cheriot_clang_purecap_stack_cap.c b/examples/cheri_c_tests/cheriot_clang_purecap_stack_cap.c
